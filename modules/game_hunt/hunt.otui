        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 8
        text: COMO O HUNT DECIDE

      HuntHint
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin: 30 14 8 14
        text: 1) Protecoes (staff, jogador, HP).  2) Cura do treinador e do Pokemon.  3) Ataque: escolhe o alvo pela prioridade, Shiny primeiro, alvo atual, HP e distancia.  4) Auto Catch: espera os corpos pendentes sem deixa-los sair da tela.  5) Rota: anda ate o proximo ponto; se travar, tenta destravar e pula o ponto.

HuntWindow < UIWindow
  id: huntWindow
  size: 700 660
  anchors.centerIn: parent
  image-border: 15
  image-source: /images/newui/background_3
  background-color: #101a23
  draggable: true
  focusable: true
  visible: false

  UIWidget
    id: headerIconBase
    size: 32 32
    anchors.left: parent.left
    anchors.top: parent.top
    margin-left: 16
    margin-top: 12
    image-source: /images/general_ui/bordered_background
    image-border: 8
    image-color: #2a6b47
    phantom: true

    UIWidget
      size: 24 24
      anchors.centerIn: parent
      image-source: /modules/game_hunt/images/icon
      phantom: true

  Label
    id: titleLabel
    anchors.left: headerIconBase.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 10
    text: Hunt
    color: #ffffff
    font: poppins bold 16
    text-auto-resize: true
    phantom: true

  Label
    id: subtitleLabel
    anchors.left: titleLabel.right
    anchors.verticalCenter: titleLabel.verticalCenter
    margin-left: 12
    text: Caca automatica por rotas, integrada ao Auto Catch
    color: #7793a7
    font: poppins semibold 10
    text-auto-resize: true
    phantom: true

  HuntCloseButton
    id: closeButton
    anchors.top: parent.top
    anchors.right: parent.right
    margin-top: 12
    margin-right: 12

  HuntPanel
    id: huntPanel
    anchors.top: headerIconBase.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8

