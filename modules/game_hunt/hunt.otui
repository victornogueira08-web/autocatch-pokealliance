HuntCard < UIWidget
  image-source: /images/general_ui/bordered_background
  image-border: 8
  image-color: #15222e

HuntPrimaryButton < UIWidget
  height: 32
  image-source: /images/newui/blueStraight
  image-border: 4
  color: #ffffff
  font: poppins bold 11
  text-align: center
  change-cursor-image: true
  cursor: pointer
  focusable: false

  $hover:
    image-color: #d9f1ff

  $pressed:
    image-color: #a8d8f4

HuntStartButton < HuntPrimaryButton
  image-color: #3fbf7f

  $hover:
    image-color: #62d99a

  $on:
    image-color: #d8505f

HuntSecondaryButton < UIWidget
  height: 26
  image-source: /images/newui/grayStraight
  image-border: 4
  color: #dbe5ec
  font: poppins semibold 9
  text-align: center
  change-cursor-image: true
  cursor: pointer
  focusable: false

  $hover:
    image-color: #d9e6ef
    color: #ffffff

  $on:
    image-source: /images/newui/blueStraight
    color: #ffffff

HuntDangerButton < HuntSecondaryButton
  image-color: #a85863
  color: #ffffff

  $hover:
    image-color: #d86d79

HuntIconButton < HuntSecondaryButton
  size: 24 22
  font: poppins bold 9

HuntTabButton < UIWidget
  height: 30
  image-source: /images/newui/grayStraight
  image-border: 4
  color: #8da3b3
  font: poppins bold 10
  text-align: center
  change-cursor-image: true
  cursor: pointer
  focusable: false

  $hover:
    image-color: #d9e6ef
    color: #ffffff

  $on:
    image-source: /images/newui/blueStraight
    color: #ffffff

HuntOptionButton < UIWidget
  height: 24
  image-source: /images/newui/grayStraight
  image-border: 4
  color: #9cb1c2
  font: poppins bold 9
  text-align: center
  change-cursor-image: true
  cursor: pointer
  focusable: false

  $hover:
    image-color: #d9e6ef
    color: #ffffff

  $on:
    image-source: /images/newui/blueStraight
    color: #ffffff

HuntItemSlot < UIItem
  size: 40 40
  virtual: true
  phantom: false
  draggable: false
  item-visible: true
  image-source: /modules/game_poketask/images/itemslot
  image-border: 2

HuntCloseButton < UIWidget
  size: 20 20
  image-source: /images/newui/close
  cursor: pointer

HuntSectionTitle < Label
  color: #7fa4bb
  font: poppins bold 10
  text-auto-resize: true
  phantom: true

HuntHint < Label
  color: #8fa9ba
  font: poppins semibold 9
  text-wrap: true
  phantom: true

HuntFieldLabel < Label
  color: #dce9f2
  font: poppins semibold 9
  text-auto-resize: true
  phantom: true

HuntNumberEdit < TextEdit
  width: 44
  height: 24
  color: #ffffff
  font: poppins bold 10
  text-align: center

HuntStatTile < HuntCard
  height: 58
  image-color: #1a2a38

HuntWaypointRow < HuntCard
  height: 30
  focusable: false

  Label
    id: wpIndex
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    width: 28
    text: 1
    color: #6f8798
    font: poppins bold 9
    text-align: right
    phantom: true

  Label
    id: wpType
    anchors.left: wpIndex.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    size: 52 18
    image-source: /images/general_ui/bordered_background
    image-border: 6
    image-color: #4aa8e0
    text: ANDAR
    color: #0d1620
    font: poppins bold 8
    text-align: center
    phantom: true

  Label
    id: wpDesc
    anchors.left: wpType.right
    anchors.right: wpUp.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    margin-right: 6
    text: -
    color: #dbe5ec
    font: poppins semibold 9
    text-wrap: false
    phantom: true

  HuntIconButton
    id: wpUp
    anchors.right: wpDown.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    text: ^
    tooltip: Subir

  HuntIconButton
    id: wpDown
    anchors.right: wpGo.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    text: v
    tooltip: Descer

  HuntIconButton
    id: wpGo
    anchors.right: wpDelete.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 3
    width: 30
    text: Ir
    tooltip: Seguir a rota a partir deste ponto

  HuntDangerButton
    id: wpDelete
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 24 22
    text: X
    tooltip: Excluir ponto

HuntTargetRow < HuntCard
  height: 32
  focusable: false

  Label
    id: targetName
    anchors.left: parent.left
    anchors.right: targetPriority.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    margin-right: 8
    text: Pokemon
    color: #dbeaf5
    font: poppins bold 10
    text-wrap: false
    phantom: true

  HuntSecondaryButton
    id: targetPriority
    anchors.right: targetEnabled.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    width: 120
    height: 22
    text: Prioridade ***--
    tooltip: Clique para mudar a prioridade (5 = ataca primeiro)

  CheckBox
    id: targetEnabled
    anchors.right: targetDelete.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 56
    text: Ativo

  HuntDangerButton
    id: targetDelete
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 24 22
    text: X

HuntMoveRow < HuntCard
  height: 32
  focusable: false

  HuntFieldLabel
    id: moveTextLabel
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    text: Comando:

  TextEdit
    id: moveText
    anchors.left: moveTextLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    width: 110
    height: 24
    color: #ffffff
    font: poppins bold 10
    tooltip: Texto enviado no chat (ex.: m1)

  HuntFieldLabel
    id: moveCooldownLabel
    anchors.left: moveText.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 12
    text: Recarga (s):

  HuntNumberEdit
    id: moveCooldown
    anchors.left: moveCooldownLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6

  CheckBox
    id: moveEnabled
    anchors.right: moveDelete.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    width: 56
    text: Ativo

  HuntDangerButton
    id: moveDelete
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 24 22
    text: X

HuntPanel < UIWidget
  id: huntPanel

  UIWidget
    id: navBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 30
    margin-left: 14
    margin-right: 14
    layout:
      type: horizontalBox
      spacing: 6
      fit-children: false

    HuntTabButton
      id: nav_dashboard
      width: 124
      text: Painel

    HuntTabButton
      id: nav_routes
      width: 124
      text: Rotas

    HuntTabButton
      id: nav_targets
      width: 124
      text: Alvos

    HuntTabButton
      id: nav_support
      width: 124
      text: Suporte

    HuntTabButton
      id: nav_safety
      width: 124
      text: Protecoes

  HuntCard
    id: statusCard
    anchors.top: navBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 70
    margin-top: 8
    margin-left: 14
    margin-right: 14

    UIWidget
      id: statusIndicator
      size: 14 14
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 14
      image-source: /images/general_ui/bordered_background
      image-border: 6
      image-color: #a85863

    Label
      id: statusTitle
      anchors.left: statusIndicator.right
      anchors.top: parent.top
      margin-left: 10
      margin-top: 8
      text: HUNT PARADO
      color: #8da3b3
      font: poppins bold 12
      text-auto-resize: true

    Label
      id: statusDetail
      anchors.left: statusIndicator.right
      anchors.top: statusTitle.bottom
      anchors.right: toggleButton.left
      margin-left: 10
      margin-right: 10
      margin-top: 1
      text: -
      color: #c5d4df
      font: poppins semibold 9
      text-wrap: false

    Label
      id: statusMessage
      anchors.left: statusIndicator.right
      anchors.top: statusDetail.bottom
      anchors.right: toggleButton.left
      margin-left: 10
      margin-right: 10
      margin-top: 1
      text: Pronto.
      color: #7fa4bb
      font: poppins semibold 9
      text-wrap: false

    HuntStartButton
      id: toggleButton
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 12
      width: 140
      height: 38
      text: INICIAR HUNT
      font: poppins bold 11
      tooltip: Liga / desliga o Hunt (Ctrl+Shift+H)

  UIWidget
    id: tab_dashboard
    anchors.top: statusCard.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8

    UIWidget
      id: statsGrid
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 124
      margin-left: 14
      margin-right: 14
      layout:
        type: grid
        cell-size: 160 58
        cell-spacing: 8
        num-columns: 4
        flow: true

      HuntStatTile
        id: tileTime
        Label
          id: stat_time
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 00:00
          color: #ffffff
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Tempo de hunt
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileKills
        Label
          id: stat_kills
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #ff9f5a
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Abates
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileKillsHour
        Label
          id: stat_killsHour
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #ffcc66
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Abates / hora
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileXpHour
        Label
          id: stat_xpHour
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #62d985
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: XP / hora
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileCatches
        Label
          id: stat_catches
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #c99bff
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Capturas (Auto Catch)
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileShinies
        Label
          id: stat_shinies
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #e0c3ff
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Shinies vistos
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileLaps
        Label
          id: stat_laps
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #62b6f0
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: Voltas na rota
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

      HuntStatTile
        id: tileSteps
        Label
          id: stat_steps
          anchors.top: parent.top
          anchors.left: parent.left
          anchors.right: parent.right
          margin-top: 8
          text: 0
          color: #9cb1c2
          font: poppins bold 16
          text-align: center
        Label
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          anchors.right: parent.right
          margin-bottom: 7
          text: SQM andados
          color: #7fa4bb
          font: poppins semibold 9
          text-align: center

    HuntCard
      id: routeCard
      anchors.top: statsGrid.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 96
      margin-top: 8
      margin-left: 14
      margin-right: 14

      HuntSectionTitle
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 8
        text: SESSAO ATUAL

      HuntSecondaryButton
        id: resetStatsButton
        anchors.right: parent.right
        anchors.top: parent.top
        margin-right: 10
        margin-top: 6
        width: 120
        height: 22
        text: Zerar contadores

      HuntHint
        id: routeInfo
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        margin-left: 14
        margin-right: 14
        margin-top: 30
        height: 14
        text: Nenhuma rota criada
        color: #dbe5ec
        text-wrap: false

      HuntHint
        id: waypointInfo
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: routeInfo.bottom
        margin-left: 14
        margin-right: 14
        margin-top: 3
        height: 14
        text: Ponto atual: -
        text-wrap: false

      HuntHint
        id: topKills
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: waypointInfo.bottom
        margin-left: 14
        margin-right: 14
        margin-top: 3
        height: 14
        text: Mais abatidos: nenhum ainda
        text-wrap: false

      HuntHint
        id: skippedInfo
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: topKills.bottom
        margin-left: 14
        margin-right: 14
        margin-top: 3
        height: 14
        text: -
        text-wrap: false

    HuntCard
      id: quickCard
      anchors.top: routeCard.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 8
      margin-left: 14
      margin-right: 14
      margin-bottom: 10

      HuntSectionTitle
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 8
        text: COMPORTAMENTO

      CheckBox
        id: optWalk
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 14
        margin-top: 32
        width: 300
        text: Seguir a rota
        tooltip: Anda pelos pontos da rota ativa

      CheckBox
        id: optAttack
        anchors.left: parent.horizontalCenter
        anchors.top: optWalk.top
        width: 300
        text: Atacar Pokemon da lista de alvos
        tooltip: Escolhe e ataca alvos segundo a aba Alvos

      CheckBox
        id: optWaitCatch
        anchors.left: parent.left
        anchors.top: optWalk.bottom
        margin-left: 14
        margin-top: 10
        width: 300
        text: Esperar o Auto Catch antes de andar
        tooltip: Nao sai de perto enquanto houver corpos para capturar

      CheckBox
        id: optStartNearest
        anchors.left: parent.horizontalCenter
        anchors.top: optWaitCatch.top
        width: 300
        text: Comecar pelo ponto mais proximo
        tooltip: Desmarcado: sempre comeca no ponto 1

      HuntHint
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 14
        margin-right: 14
        margin-bottom: 8
        height: 28
        text: Atalhos: Ctrl+Shift+H liga/desliga o Hunt  |  Ctrl+Shift+J adiciona um ponto na sua posicao (tipo escolhido na aba Rotas).

  UIWidget
    id: tab_routes
    anchors.top: statusCard.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 8
    visible: false

    HuntCard
      id: routeHeaderCard
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 96
      margin-left: 14
      margin-right: 14

      HuntIconButton
        id: routePrev
        anchors.left: parent.left
        anchors.top: parent.top
        margin-left: 10
        margin-top: 8
        size: 26 24
        text: <
        tooltip: Rota anterior

      Label
        id: routeName
        anchors.left: routePrev.right
        anchors.right: routeNext.left
        anchors.verticalCenter: routePrev.verticalCenter
        margin-left: 6
        margin-right: 6
        text: Nenhuma rota
        color: #ffffff
        font: poppins bold 11
        text-align: center
        phantom: true

      HuntIconButton
        id: routeNext
        anchors.right: routeNew.left
        anchors.verticalCenter: routePrev.verticalCenter
        margin-right: 10
        size: 26 24
        text: >
        tooltip: Proxima rota

      HuntPrimaryButton
        id: routeNew
        anchors.right: routeDelete.left
        anchors.verticalCenter: routePrev.verticalCenter
        margin-right: 6
        width: 70
        height: 24
        font: poppins bold 9
        text: + Nova

      HuntDangerButton
        id: routeDelete
        anchors.right: parent.right
        anchors.verticalCenter: routePrev.verticalCenter
        margin-right: 10
        width: 76
        height: 24
        text: Excluir
        tooltip: Clique duas vezes para confirmar

      HuntHint
        id: routeSummary
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: routePrev.bottom
        margin-left: 12
        margin-right: 12
        margin-top: 4
        height: 14
        text: -
        text-align: center
        text-wrap: false

      TextEdit
        id: routeNameEdit
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-left: 10
        margin-bottom: 9
        width: 150
        height: 24
        color: #ffffff
        font: poppins bold 10
        tooltip: Nome da rota

      HuntSecondaryButton
        id: routeRename
        anchors.left: routeNameEdit.right
        anchors.verticalCenter: routeNameEdit.verticalCenter
        margin-left: 4
        width: 70
        height: 24
        text: Renomear

      HuntSecondaryButton
        id: routeMode
        anchors.left: routeRename.right
        anchors.verticalCenter: routeNameEdit.verticalCenter
        margin-left: 8
        width: 120
        height: 24
        text: Modo: Loop
        tooltip: Loop: volta ao ponto 1. Ida e volta: percorre ao contrario. Uma vez: para no fim.

      HuntSecondaryButton
        id: routeReverse
        anchors.left: routeMode.right
        anchors.verticalCenter: routeNameEdit.verticalCenter
        margin-left: 4
        width: 64
        height: 24
        text: Inverter

      HuntSecondaryButton
        id: routeExport
        anchors.left: routeReverse.right
        anchors.verticalCenter: routeNameEdit.verticalCenter
        margin-left: 4
        width: 70
        height: 24
        text: Exportar
        tooltip: Copia a rota para a area de transferencia

      HuntSecondaryButton
        id: routeImport
        anchors.left: routeExport.right
        anchors.right: parent.right
        anchors.verticalCenter: routeNameEdit.verticalCenter
        margin-left: 4
        margin-right: 10
        height: 24
        text: Importar
        tooltip: Cria uma rota a partir do texto copiado

    HuntCard
      id: waypointToolsCard
      anchors.top: routeHeaderCard.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 116
      margin-top: 8
      margin-left: 14
      margin-right: 14

      UIWidget
        id: typeBar
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 24
        margin-top: 8
        margin-left: 10
        margin-right: 10
        layout:
          type: horizontalBox
          spacing: 4

        HuntOptionButton
          id: type_walk
          width: 84
          text: Caminhar
          tooltip: Anda ate o ponto (com tolerancia)
        HuntOptionButton
          id: type_exact
          width: 84
          text: Exato
          tooltip: Pisa exatamente no tile (escada, buraco, teleporte)
        HuntOptionButton
          id: type_stand
          width: 84
          text: Parar
          tooltip: Fica parado alguns segundos (lure)
        HuntOptionButton
          id: type_use
          width: 84
          text: Usar
          tooltip: Usa o tile (alavanca, porta, escada de mao)
        HuntOptionButton
          id: type_say
          width: 84
          text: Falar
          tooltip: Fala um texto no chat
        HuntOptionButton
          id: type_label
          width: 84
          text: Marcador
          tooltip: Marca um ponto da rota com um nome
        HuntOptionButton
          id: type_goto
          width: 84
          text: Ir para
          tooltip: Pula para um marcador

      HuntHint
        id: wpParamHint
        anchors.left: parent.left
        anchors.top: typeBar.bottom
        margin-left: 12
        margin-top: 10
        width: 190
        height: 14
        text: -
        text-wrap: false

      TextEdit
        id: wpParamEdit
        anchors.left: wpParamHint.right
        anchors.verticalCenter: wpParamHint.verticalCenter
        margin-left: 6
        width: 130
        height: 24
        color: #ffffff
        font: poppins bold 10

      HuntPrimaryButton
        id: wpAddHere
        anchors.left: wpParamEdit.right
        anchors.verticalCenter: wpParamHint.verticalCenter
        margin-left: 8
        width: 112
        height: 26
        font: poppins bold 9
        text: + Ponto aqui
        tooltip: Adiciona um ponto na sua posicao (Ctrl+Shift+J)

      HuntSecondaryButton
        id: wpAddMap
        anchors.left: wpAddHere.right
        anchors.right: parent.right
        anchors.verticalCenter: wpParamHint.verticalCenter
        margin-left: 6
        margin-right: 10
        height: 26
        text: + Clicar no mapa

      HuntSecondaryButton
        id: wpRecord
        anchors.left: parent.left
        anchors.bottom: parent.bottom
        margin-left: 10
